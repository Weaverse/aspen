{
  "name": "@weaverse/aspen",
  "private": true,
  "sideEffects": false,
  "version": "1.0.0",
  "type": "module",
  "author": "Weaverse",
  "scripts": {
    "build": "shopify hydrogen codegen && react-router build",
    "dev": "react-router typegen && shopify hydrogen dev --codegen --port 3456",
    "dev:ca": "shopify hydrogen dev --codegen --port 3456 --customer-account-push",
    "preview": "shopify hydrogen preview --build",
    "start": "shopify hydrogen preview",
    "typecheck": "react-router typegen && tsc --noEmit",
    "routes-check": "shopify hydrogen check routes",
    "codegen": "shopify hydrogen codegen",
    "hydrogen": "shopify hydrogen",
    "clean": "rm -rf dist node_modules package-lock.json pnpm-lock.yaml .shopify .react-router",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "biome": "biome check",
    "biome:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "i18n:scan": "node scripts/check-hardcoded-translations.mjs",
    "i18n:check": "node scripts/check-translations.mjs && node scripts/check-hardcoded-translations.mjs",
    "locale:check": "node --test tests/locale.unit.test.ts",
    "cf-typegen": "wrangler types && react-router typegen",
    "check": "react-router typegen && tsc --noEmit && react-router build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "cf-dev": "wrangler dev --port 8787"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/tenor-sans": "^5.2.6",
    "@graphql-codegen/cli": "7.2.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-visually-hidden": "1.2.11",
    "@react-router/dev": "7.18.2",
    "@shopify/hydrogen": "^2026.4.4",
    "@tailwindcss/vite": "^4.3.3",
    "@weaverse/hydrogen": "^5.19.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "colord": "2.9.3",
    "framer-motion": "12.23.6",
    "graphql": "16.14.2",
    "isbot": "^5.2.1",
    "react": "19.2.8",
    "react-country-flag": "3.1.0",
    "react-dom": "19.2.8",
    "react-intersection-observer": "10.1.0",
    "react-player": "^3.4.0",
    "react-router": "7.18.2",
    "react-share": "5.3.0",
    "react-use": "17.6.1",
    "schema-dts": "2.0.0",
    "swiper": "^14.0.6",
    "tailwind-merge": "3.6.0",
    "tiny-invariant": "1.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/vite-plugin": "^1.54.3",
    "@playwright/test": "1.62.0",
    "@shopify/cli": "^4.5.2",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "^4.2.2",
    "@shopify/oxygen-workers-types": "4.2.0",
    "@tailwindcss/typography": "0.5.20",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@weaverse/biome": "5.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "@graphql-codegen/add": "6.0.1",
    "@graphql-codegen/plugin-helpers": "6.3.0",
    "@graphql-codegen/schema-ast": "5.0.2",
    "@graphql-codegen/typescript": "5.0.10",
    "@graphql-codegen/typescript-operations": "5.1.0",
    "@graphql-codegen/visitor-plugin-common": "6.3.0",
    "@shopify/mini-oxygen": {
      "body-parser": {
        ".": "1.20.6",
        "qs": "6.15.3"
      },
      "miniflare": {
        "undici": "6.28.0",
        "ws": "8.21.3",
        "youch": "3.3.4"
      },
      "undici": "7.29.0"
    },
    "lodash": "4.18.1",
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}